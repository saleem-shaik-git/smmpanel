APP_ENV=local
APP_URL=http://localhost/smmpanel/public
APP_TIMEZONE=Africa/Lagos

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smmpanel
DB_USERNAME=root
DB_PASSWORD=

MARKETERUM_API_URL=https://marketerum.com/api/v2
MARKETERUM_API_KEY=replace_with_your_key
MARKETERUM_TIMEOUT=30
MARKETERUM_CURRENCY=USD
# Explicit provider-to-retail FX rate. Example only; set from your approved FX source.
MARKETERUM_TO_NGN_RATE=0

# Retail pricing defaults
DEFAULT_MARKUP_PERCENT=40
CURRENCY=NGN

# Paystack - keep secret key server-side and never commit it
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
